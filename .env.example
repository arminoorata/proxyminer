# Postgres (Neon, provisioned via Vercel Marketplace).
# Vercel auto-injects this when the Neon integration is added.
DATABASE_URL=postgres://user:pass@host/proxyminer?sslmode=require

# Vercel Blob (provisioned via Vercel Storage).
# Vercel auto-injects this.
BLOB_READ_WRITE_TOKEN=

# AI Gateway (provisioned via Vercel AI).
# Vercel auto-injects this.
AI_GATEWAY_API_KEY=

# SEC EDGAR contact identifier — required by SEC's User-Agent policy.
# Format: "Org Name email@domain.com". Set in Vercel project env.
PROXYMINER_SEC_USER_AGENT=ProxyMiner armi.noorata@gmail.com

# Admin token guarding the review console + ingestion routes.
# Generate with `openssl rand -hex 32`.
PROXYMINER_ADMIN_API_TOKEN=

# Cookie signing secret for review session cookies.
# Generate with `openssl rand -hex 32`.
PROXYMINER_REVIEW_COOKIE_SECRET=

# Optional override for the assistant's default model id.
# Defaults to `anthropic/claude-haiku-4-5` (fast + grounded use case).
# Set `anthropic/claude-sonnet-4-6` for deeper reasoning runs.
PROXYMINER_ASSISTANT_MODEL=anthropic/claude-haiku-4-5
