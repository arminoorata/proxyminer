{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/refresh-pilot?chunk=0&cohort=all", "schedule": "0 6 * * 1" },
    { "path": "/api/cron/refresh-pilot?chunk=1&cohort=all", "schedule": "30 6 * * 1" },
    { "path": "/api/cron/refresh-pilot?chunk=2&cohort=all", "schedule": "0 7 * * 1" },
    { "path": "/api/cron/refresh-pilot?chunk=3&cohort=all", "schedule": "30 7 * * 1" },
    { "path": "/api/cron/refresh-pilot?chunk=4&cohort=all", "schedule": "0 8 * * 1" },
    { "path": "/api/cron/reap-stale-jobs", "schedule": "15 5 * * *" }
  ],
  "functions": {
    "src/app/api/admin/ingest/[identifier]/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/refresh-pilot/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/ask/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
