{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/refresh-pilot?chunk=0", "schedule": "0 6 * * 1" },
    { "path": "/api/cron/refresh-pilot?chunk=1", "schedule": "30 6 * * 1" },
    { "path": "/api/cron/refresh-pilot?chunk=2", "schedule": "0 7 * * 1" }
  ],
  "functions": {
    "src/app/api/admin/ingest/[identifier]/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/refresh-pilot/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/ask/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
