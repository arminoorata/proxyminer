# Build / runtime
.next/
out/
build/
dist/
node_modules/

# Env
.env
.env*.local

# Logs
npm-debug.log*
*.log

# OS
.DS_Store

# Test
coverage/

# Python bytecode (workflow driver scripts under .github/workflows/scripts/)
__pycache__/
*.pyc

# Vercel
.vercel/

# Fixture artifacts that are large but reproducible; commit the JSON
# fixtures (the parity contract) but NOT the multi-MB raw HTML copies —
# those can be re-derived via `npm run fixtures:freeze` from the oracle
# repo on this machine. Same for the test-cases archive.
.fixtures/by-filing/**/source.html
.fixtures/test-cases/test_*.py
# Postgres freezer scratch dirs (atomic swap via temp + .old backup) — a hard
# kill mid-freeze can leave these behind; never let partial state be committed.
.fixtures/.by-filing.tmp/
.fixtures/.by-filing.old/
.codex/
.vercel
